{
  "name": "admin-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "npm run dev:backend & npm run dev:salesman & npm run dev",
    "dev:salesman": "UNIFIED_APP=1 npm --prefix salesman-dashboard run dev",
    "build": "tsc -b && vite build && npm run build:salesman",
    "lint": "eslint src tests backend/*.js backend/tests/*.js",
    "preview": "vite preview",
    "test": "vitest run",
    "build:salesman": "UNIFIED_APP=1 npm --prefix salesman-dashboard run build && node scripts/copy-salesman.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
