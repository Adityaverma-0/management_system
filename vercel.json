{
  "rewrites": [
    {
      "source": "/salesman",
      "destination": "/salesman/index.html"
    },
    {
      "source": "/salesman/:path*",
      "destination": "/salesman/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npm ci && npm --prefix salesman-dashboard ci"
}
